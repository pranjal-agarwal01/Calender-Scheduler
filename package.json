{
  "name": "calendar-scheduler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Calendar scheduler built with React, Tailwind CSS and Axios on top of DummyJSON.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
